# Server
HOST=0.0.0.0
PORT=1337

# Secrets — generate your own with: openssl rand -base64 32
# APP_KEYS takes a comma separated list of at least two keys.
APP_KEYS=replace-me-key-one,replace-me-key-two
API_TOKEN_SALT=replace-me
ADMIN_JWT_SECRET=replace-me
TRANSFER_TOKEN_SALT=replace-me
JWT_SECRET=replace-me
ENCRYPTION_KEY=replace-me

# Database — PostgreSQL (see docker-compose.yml in the repository root)
DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=lumea
DATABASE_USERNAME=lumea
DATABASE_PASSWORD=lumea
DATABASE_SSL=false
# On hosted Postgres (Render, Neon, Supabase) a single connection string is
# usually provided instead — it takes precedence over the fields above:
# DATABASE_URL=postgres://user:password@host:5432/database
# DATABASE_SSL=true

# Frontend origins allowed to call the API (comma separated).
CORS_ORIGINS=http://localhost:3000

# Media storage. Without these the local `public/uploads` folder is used, which
# is fine locally but ephemeral on free hosting.
# CLOUDINARY_NAME=
# CLOUDINARY_KEY=
# CLOUDINARY_SECRET=

# Set to true to re-create the demo content on the next start.
SEED_FORCE=false
