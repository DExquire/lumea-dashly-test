# Public URL of the Strapi instance (used for API calls and next/image hosts).
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337

# Optional read-only Strapi API token. Leave empty when the `find` endpoints
# are public (default for this project).
STRAPI_API_TOKEN=

# Extra media origins for next/image, comma separated (CDN, S3, Cloudinary...).
NEXT_PUBLIC_MEDIA_ORIGINS=

# Canonical site URL — used for metadataBase and Open Graph tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ISR revalidation window for Strapi content, in seconds.
NEXT_PUBLIC_REVALIDATE_SECONDS=60
